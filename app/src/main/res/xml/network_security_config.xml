<?xml version="1.0" encoding="utf-8"?>
<!--
  Internet radio: many stations (e.g. VRT's MNM) only stream over plain http, which Android blocks
  by default. Allow cleartext so those streams play. Our own API calls (Radio Browser, Open-Meteo,
  GitHub releases) all use https anyway.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
